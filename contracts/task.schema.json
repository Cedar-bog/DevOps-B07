{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cedar-bog/DevOps-B07/main/contracts/task.schema.json",
  "title": "DevOps-B07 Unified Task Model",
  "description": "DRAFT、FULL_CHECK、INCREMENTAL_CHECK、REPAIR 四类任务的统一任务模型。",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "trace_id",
    "job_type",
    "status",
    "execution",
    "input",
    "output",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0",
      "description": "契约版本。"
    },
    "job_id": {
      "$ref": "#/$defs/job_id",
      "description": "任务编号，由服务端生成。"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^trace-[a-z0-9-]+$",
      "description": "串联同一次平台流程下所有任务的标识。"
    },
    "job_type": {
      "enum": ["DRAFT", "FULL_CHECK", "INCREMENTAL_CHECK", "REPAIR"],
      "description": "任务类型。"
    },
    "status": {
      "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "TIMED_OUT", "CANCELLED"],
      "description": "任务状态。SUCCEEDED 表示检测正常完成，此时仍可能报告 MISSING 或 REDUNDANT 发现。"
    },
    "execution": {
      "type": "object",
      "required": ["created_at"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "queued_at": { "type": "string", "format": "date-time" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "attempts": { "type": "integer", "minimum": 1 },
        "runner": { "type": "string", "description": "实际执行节点标识。" }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "description": "任务输入，结构由 job_type 决定。"
    },
    "output": {
      "type": ["object", "null"],
      "description": "任务输出与产物引用，任务未完成时为空。"
    },
    "error": {
      "type": ["object", "null"],
      "description": "系统执行错误。检测发现写入 output，不写此处。",
      "properties": {
        "code": {
          "enum": ["ENV_3002", "EXEC_4002", "ANALYSIS_5001"],
          "description": "系统执行错误码。ENV_3002 镜像构建失败，EXEC_4002 任务超时，ANALYSIS_5001 分析器失败。"
        },
        "message": { "type": "string" },
        "details": { "type": ["object", "null"] }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "job_type": { "const": "DRAFT" } }, "required": ["job_type"] },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "required": ["repository", "build", "verify", "max_iterations", "time_limit", "idempotency_key"],
            "properties": {
              "repository": { "$ref": "#/$defs/repository" },
              "build": {
                "type": "object",
                "required": ["command"],
                "properties": {
                  "command": { "type": "string", "minLength": 1, "description": "构建命令。" },
                  "workdir": { "type": "string", "description": "工作目录。" }
                },
                "additionalProperties": false
              },
              "verify": {
                "type": "object",
                "required": ["command"],
                "properties": {
                  "command": { "type": "string", "minLength": 1, "description": "验证命令。" }
                },
                "additionalProperties": false
              },
              "max_iterations": { "type": "integer", "minimum": 1, "description": "最大迭代次数。" },
              "time_limit": { "type": "integer", "minimum": 1, "description": "时间限制，单位秒。" },
              "idempotency_key": { "type": "string", "minLength": 1, "description": "幂等键。" }
            },
            "additionalProperties": false
          },
          "output": {
            "type": ["object", "null"],
            "required": ["dockerfile", "image_ref", "rounds", "final_build", "final_verify"],
            "properties": {
              "dockerfile": { "type": "string", "description": "生成的 Dockerfile 文本。" },
              "image_ref": { "type": "string", "description": "镜像引用。" },
              "rounds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["iteration", "log", "changes", "rationale"],
                  "properties": {
                    "iteration": { "type": "integer", "minimum": 1 },
                    "log": { "type": "string", "description": "本轮构建日志。" },
                    "changes": { "type": "string", "description": "本轮对 Dockerfile 的修改。" },
                    "rationale": { "type": "string", "description": "本轮修改的理由。" }
                  },
                  "additionalProperties": false
                }
              },
              "final_build": { "type": "string", "description": "最终构建结果。" },
              "final_verify": { "type": "string", "description": "最终验证结果。" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "job_type": { "const": "FULL_CHECK" } }, "required": ["job_type"] },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "required": ["repository", "environment", "build", "configuration_id", "commit", "defined_by", "idempotency_key"],
            "properties": {
              "repository": { "$ref": "#/$defs/repository" },
              "environment": {
                "type": "object",
                "required": ["image", "project_root"],
                "properties": {
                  "image": { "type": "string", "minLength": 1, "description": "运行环境镜像。" },
                  "project_root": { "type": "string", "minLength": 1, "description": "项目根目录。" }
                },
                "additionalProperties": false
              },
              "build": { "$ref": "#/$defs/check_build" },
              "configuration_id": { "type": "string", "minLength": 1, "description": "构建配置标识。" },
              "commit": { "$ref": "#/$defs/commit" },
              "defined_by": { "const": "A07" },
              "idempotency_key": { "type": "string", "minLength": 1, "description": "幂等键。" }
            },
            "additionalProperties": false
          },
          "output": {
            "anyOf": [
              { "$ref": "#/$defs/artifact_set" },
              { "type": "null" }
            ],
            "description": "输出为产物引用：实际依赖图、声明依赖图、MD 与 RD 报告。"
          }
        }
      }
    },
    {
      "if": { "properties": { "job_type": { "const": "INCREMENTAL_CHECK" } }, "required": ["job_type"] },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "required": ["base_commit", "repository", "environment", "build", "configuration_id", "baseline", "commit", "defined_by", "idempotency_key"],
            "properties": {
              "base_commit": { "$ref": "#/$defs/commit", "description": "基线提交 SHA。" },
              "repository": { "$ref": "#/$defs/repository" },
              "environment": {
                "type": "object",
                "required": ["image", "project_root"],
                "properties": {
                  "image": { "type": "string", "minLength": 1, "description": "运行环境镜像。" },
                  "project_root": { "type": "string", "minLength": 1, "description": "项目根目录。" }
                },
                "additionalProperties": false
              },
              "build": { "$ref": "#/$defs/check_build" },
              "configuration_id": { "type": "string", "minLength": 1, "description": "构建配置标识。" },
              "baseline": {
                "type": "object",
                "required": ["actual_graph_uri", "commit", "configuration_id"],
                "properties": {
                  "actual_graph_uri": { "$ref": "#/$defs/artifact_uri", "description": "基线依赖图产物 URI。" },
                  "commit": { "$ref": "#/$defs/commit" },
                  "configuration_id": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                },
                "additionalProperties": false,
                "description": "增量检测必须携带的历史基线。"
              },
              "commit": { "$ref": "#/$defs/commit", "description": "新提交 SHA。" },
              "defined_by": { "const": "A07" },
              "idempotency_key": { "type": "string", "minLength": 1, "description": "幂等键。" }
            },
            "additionalProperties": false
          },
          "output": {
            "anyOf": [
              { "$ref": "#/$defs/artifact_set" },
              { "type": "null" }
            ],
            "description": "输出为产物引用：当前发现、新增或消除的发现、更新后的依赖图。"
          }
        }
      }
    },
    {
      "if": { "properties": { "job_type": { "const": "REPAIR" } }, "required": ["job_type"] },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "required": ["repository", "commit", "md_report_uri", "makefile", "env", "verify", "idempotency_key"],
            "properties": {
              "repository": { "$ref": "#/$defs/repository" },
              "commit": { "$ref": "#/$defs/commit" },
              "md_report_uri": { "$ref": "#/$defs/artifact_uri", "description": "MD 报告 URI，只消费 MISSING 类型。" },
              "makefile": { "type": "string", "description": "Makefile 文本或路径。" },
              "env": {
                "type": "object",
                "required": ["build", "verify"],
                "properties": {
                  "build": { "type": "string", "minLength": 1, "description": "构建命令。" },
                  "verify": { "type": "string", "minLength": 1, "description": "验证命令。" }
                },
                "additionalProperties": false
              },
              "verify": { "type": "string", "minLength": 1, "description": "构建与验证命令。" },
              "idempotency_key": { "type": "string", "minLength": 1, "description": "幂等键。" }
            },
            "additionalProperties": false
          },
          "output": {
            "type": ["object", "null"],
            "required": ["git_patch", "style_description", "recheck", "rejected_candidates"],
            "properties": {
              "git_patch": { "type": "string", "description": "生成的 Git Patch。" },
              "style_description": { "type": "string", "description": "声明风格说明。" },
              "recheck": {
                "type": "object",
                "required": ["build", "test", "detection"],
                "properties": {
                  "build": { "type": "string" },
                  "test": { "type": "string" },
                  "detection": { "type": "string" }
                },
                "additionalProperties": false
              },
              "rejected_candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["patch", "reason"],
                  "properties": {
                    "patch": { "type": "string" },
                    "reason": { "type": "string", "description": "拒绝该候选的原因。" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "$defs": {
    "repository": {
      "type": "object",
      "required": ["url", "commit"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https?://", "description": "仓库地址。" },
        "commit": { "$ref": "#/$defs/commit" }
      },
      "additionalProperties": false
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "完整提交 SHA。"
    },
    "check_build": {
      "type": "object",
      "required": ["clean_command", "build_command"],
      "properties": {
        "clean_command": { "type": "string", "minLength": 1, "description": "清理命令。" },
        "build_command": { "type": "string", "minLength": 1, "description": "构建命令。" },
        "verify_command": { "type": "string", "description": "验证命令。" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "description": "超时时间，单位秒。" }
      },
      "additionalProperties": false
    },
    "artifact_uri": {
      "type": "string",
      "pattern": "^artifact://",
      "description": "产物 URI，以 artifact:// 为前缀。"
    },
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "type", "uri", "media_type", "producer_job_id"],
      "properties": {
        "artifact_id": { "type": "string" },
        "type": { "type": "string", "description": "产物类型。" },
        "uri": { "$ref": "#/$defs/artifact_uri" },
        "media_type": { "type": "string", "description": "媒体类型。" },
        "producer_job_id": { "$ref": "#/$defs/job_id" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "完整性校验值。" }
      },
      "additionalProperties": false
    },
    "artifact_set": {
      "type": "object",
      "required": ["artifacts"],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "job_id": {
      "type": "string",
      "pattern": "^job-[a-z0-9-]+$"
    }
  }
}